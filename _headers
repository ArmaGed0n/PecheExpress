/
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/index.html
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

/sw.js
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/changelog.json
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/css/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/icons/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff

/.netlify/functions/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
